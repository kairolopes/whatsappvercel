{
  "functions": {
    "api/**/*.ts": {
      "includeFiles": [
        "api/lib/condoDocs.index.json",
        "*.pdf"
      ]
    }
  },
  "routes": [
    { "handle": "filesystem" },
    { "src": "^/api/zapi/(.*)$", "dest": "/api/zapi?route=$1" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
